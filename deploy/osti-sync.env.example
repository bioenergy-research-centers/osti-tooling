OSTI_ROOT=/opt/osti
PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin

OSTI_TOOLING_DIR=$OSTI_ROOT/osti-tooling
BRC_SCHEMA_DIR=$OSTI_ROOT/brc-schema
BRC_DATA_FEEDS_DIR=$OSTI_ROOT/brc_data_feeds
REPO_DIR=$OSTI_ROOT/brc-schema

STATE_DIR=$OSTI_ROOT/state
OUT_DIR=$OSTI_ROOT/state/runs
ELINK_OUT_DIR=$OSTI_ROOT/state/elink_output
BRC_OUT_DIR=$OSTI_ROOT/state/brc_output
LOG_DIR=$OSTI_ROOT/logs
WORKFLOW_LOG=$OSTI_ROOT/logs/osti_workflow.log
LOG_FILE=$OSTI_ROOT/logs/osti_workflow.log
LOCK_FILE=$OSTI_ROOT/state/osti_hourly_sync.lock
SCHOLAR_OUTPUT_DIR=$OSTI_ROOT/scholar_output
SCHOLAR_OUT_DIR=$OSTI_ROOT/scholar_output
SCHOLAR_OUTPUT_FILE=$OSTI_ROOT/scholar_output/latest_osti_scholar_records.json
SCHOLAR_JSON=$OSTI_ROOT/scholar_output/latest_osti_scholar_records.json
CONFIG_INI=/var/www/OSTI_config.ini
UV_CACHE_DIR=$OSTI_ROOT/state/uv-cache
XDG_CACHE_HOME=$OSTI_ROOT/state/.cache
XDG_DATA_HOME=$OSTI_ROOT/state/.data
PYSTOW_HOME=$OSTI_ROOT/state/pystow

SITE_OWNERSHIP_CODE=CBI
ENABLE_RECENT_SITE_DISCOVERY=1
RECENT_SITE_LOOKBACK_DAYS=14
RECENT_SITE_MAX_IDS=40
DIRECT_OSTI_DISCOVERY=1

# Canonical publish policy:
# - gscholscrape dedupe input is staged explicitly at SCRAPER_DEDUPE_JSON
# - downstream_sync publishes its canonical outputs under $OSTI_ROOT/state/published
# - cbi.json is then copied into brc_data_feeds for commit/push
SCRAPER_DEDUPE_JSON=/var/www/html/cbi.json
WEB_BRC_JSON=$OSTI_ROOT/state/published/cbi.json
WEB_OSTI_JSON=$OSTI_ROOT/state/published/osti.json
WEB_PUBLICATIONS_JSON=$OSTI_ROOT/state/published/publications.json

# Use the same interpreter family that has the playwright package installed.
SCHOLAR_PYTHON_BIN=python3
# Empty uses static HTTP collection. Set to playwright only if static collection
# is blocked and the browser is installed in the configured XDG cache.
SCHOLAR_BROWSER_MODE=

# Required secret for downstream_sync / eLink requests.
ELINK_BEARER_TOKEN=replace-me